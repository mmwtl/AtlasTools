<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- AOT catalog: lets the app read the debuggable flag. Keep in sync with AotCatalog. -->
    <queries>
        <package android:name="com.geely.atlaslauncher" />
        <package android:name="com.mmwtl.atlasappwidget" />
        <package android:name="com.mmwtl.atlasappwindow" />
        <package android:name="com.mmwtl.atlasclimatewidget" />
        <package android:name="com.mmwtl.atlasmediawidget" />
        <package android:name="com.mmwtl.atlasmediaapi" />
        <package android:name="com.mmwtl.atlasdim" />
        <package android:name="com.mmwtl.atlasterminal" />
        <package android:name="com.mmwtl.gibcompanion" />
        <package android:name="com.salat.gbinder" />
        <package android:name="com.salat.gsplit" />
        <package android:name="com.andrerinas.headunitrevived" />
        <package android:name="com.andrerinas.headunitrevived.geely" />
        <package android:name="com.geely.online.service" />
        <package android:name="com.salat.gmediahud" />
    </queries>

    <application
        android:name=".CodecFixApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AtlasCodecFix">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AtlasCodecFix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".AutoApplyReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AutoApplyAccessibilityService"
            android:description="@string/auto_apply_accessibility_description"
            android:exported="true"
            android:label="@string/auto_apply_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/auto_apply_accessibility_service" />
        </service>

        <service
            android:name=".AutoApplyJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
